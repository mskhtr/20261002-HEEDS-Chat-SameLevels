# コピーして .env を作り、空欄を埋めてください。
#   PowerShell: copy .env.example .env
# .env は Git に上げません。

# ----- AI（Azure OpenAI） -----
# 実行後の要約に使います。どの試験を実行するかは catalog.yaml が決めます。
LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
OPENAI_API_VERSION=2024-10-21

# ----- HEEDS -----
# HEEDSMDO.exe のフルパス
# 例: C:/Program Files/Siemens/HEEDS/2504/HEEDSMDO.exe
HEEDS_EXE=
# 使う .heeds ファイルのフルパス。リポジトリ内の HEEDS_PROJECT/ に置けます。
# 例: C:/Users/masaki/Documents/python-projects/20261002_HEEDS-Chat-SameLevels/HEEDS_PROJECT/MyProject.heeds
HEEDS_PROJECT_PATH=
# 実行の待ち時間（秒）
HEEDS_TIMEOUT_SEC=3600

# Study の画面名は heeds/catalog.yaml の heeds_name が既定です。
# この PC だけ名前が違うときだけ、試験 ID を大文字にした名前で上書きします。
# 例: HEEDS_STUDY_STRESS=Study_stress
